// File name: projects/3/a/Register.hdl
/**
 * 16-bit register:
 * If load is asserted, the register's value is set to in;
 * Otherwise, the register maintains its current value:
 * if (load(t)) out(t+1) = int(t), else out(t+1) = out(t)
 */
CHIP Register {
    IN in[16], load;
    OUT out[16];

    PARTS:
    //// approach: use a mux to select between the input and the output of the register based off the load signal

    // use a mux to select between the input and the output of the register based off the load signal
    Mux16(a=out, b=in, sel=load, out=next);

    // use a register to store the value of the register
    DFF(in=next, out=out);
}
