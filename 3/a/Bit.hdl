// File name: projects/3/a/Bit.hdl
/**
 * 1-bit register:
 * If load is asserted, the register's value is set to in;
 * Otherwise, the register maintains its current value:
 * if (load(t)) out(t+1) = in(t), else out(t+1) = out(t)
 */
CHIP Bit {
    IN in, load;
    OUT out;

    PARTS:
    /// approach: use the dff to store the value, and use a mux to select between the current value and the input value based on the load signal

    // select between the current bit and the input bit based on load
    Mux(a=out1, b=in, sel=load, out=next);

    // store the selected value
    DFF(in=next, out=out, out=out1);
}
