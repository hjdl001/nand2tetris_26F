// File name: projects/3/a/Bit.hdl
/**
 * 1-bit register:
 * If load is asserted, the register's value is set to in;
 * Otherwise, the register maintains its current value:
 * if (load(t)) out(t+1) = in(t), else out(t+1) = out(t)
 */
CHIP Bit {
    IN in, load;
    OUT out;

    PARTS:
    //// approach: use a dff to store value of the register
    // use the mux to select between the input and the output of the dff based off the load signal 

    // use a dff to store the value of the register
    DFF(in=next, out=out);

    //use a mux to select between the input and value of the register
    Mux(a=out, b=in, sel=load, out=next);
}
