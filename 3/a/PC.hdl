// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], inc, load, reset;
    OUT out[16];

    PARTS:
    /// approach: use a register to store the value
    /// and use a series of muxes to select between the current value, the input value, and the incremented value based on the control signals
    
    // increment the current value
    Inc16(in=out1, out=incOut);

    // if inc is asserted, use the incremented value; otherwise keep the current value
    Mux16(a=out1, b=incOut, sel=inc, out=incMuxOut);

    // if load is asserted, use the input value; otherwise use the inc/hold result
    Mux16(a=incMuxOut, b=in, sel=load, out=loadMuxOut);

    // if reset is asserted, use zero; otherwise keep the chosen load/inc/hold result
    Mux16(a=loadMuxOut, b=false, sel=reset, out=next);

    // update the register whenever any action is requested
    Register(in=next, load=true, out=out1, out=out);
}
