// File name: projects/1/Not.hdl
/**
 * Not gate:
 * if (in) out = 0, else out = 1
 */
CHIP Not {
    IN in;
    OUT out;

    PARTS:
    // define the not gate using a nand gate
    Nand(a=in, b=in, out=out); // nand gate returns 0 if both a and b are 1, else returns 1
}
