// File name: projects/1/DMux.hdl
/**
 * Demultiplexor:
 * [a, b] = [in, 0] if sel = 0
 *          [0, in] if sel = 1
 */
CHIP DMux {
    IN in, sel;
    OUT a, b;

    PARTS:
    // define the 2-way demultiplexer
    // use Not gate to invert the sel input
    // use the and gate to perform the rest
        Not(in=sel, out=nsel); // sel = 0 -> nsel = 1
        And(a=in, b=nsel, out=a); // if sel = 0, then a = in
        And(a=in, b=sel, out=b); // if sel = 1, then b = in

}
