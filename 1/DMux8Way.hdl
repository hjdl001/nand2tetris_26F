// File name: projects/1/DMux8Way.hdl
/**
 * 8-way demultiplexor:
 * [a, b, c, d, e, f, g, h] = [in, 0,  0,  0,  0,  0,  0,  0] if sel = 000
 *                            [0, in,  0,  0,  0,  0,  0,  0] if sel = 001
 *                            [0,  0, in,  0,  0,  0,  0,  0] if sel = 010
 *                            [0,  0,  0, in,  0,  0,  0,  0] if sel = 011
 *                            [0,  0,  0,  0, in,  0,  0,  0] if sel = 100
 *                            [0,  0,  0,  0,  0, in,  0,  0] if sel = 101
 *                            [0,  0,  0,  0,  0,  0, in,  0] if sel = 110
 *                            [0,  0,  0,  0,  0,  0,  0, in] if sel = 111
 */
CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    // define the 8-way demultiplexer
    // use a 2-way demultiplexer to split the input into two groups of four outputs
    // then use two 4-way demultiplexers to split each group into four outputs
        DMux(in=in, sel=sel[2], a=abcd, b=efgh); // if sel[2] = 0, then abcd = in, else efgh = in
        DMux4Way(in=abcd, sel=sel[0..1], a=a, b=b, c=c, d=d); // if sel[0..1] = 00, then a = abcd, else b/c/d
        DMux4Way(in=efgh, sel=sel[0..1], a=e, b=f, c=g, d=h); // if sel[0..1] = 00, then e = efgh, else f/g/h
}
