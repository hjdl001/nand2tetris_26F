// File name: projects/1/Or8Way.hdl
/**
 * 8-way Or gate: 
 * out = in[0] Or in[1] Or ... Or in[7]
 */
CHIP Or8Way {
    IN in[8];
    OUT out;

    PARTS:
    // define the 8-way or gate using 7 or gates
    // used 7 or gates to combine the 8 inputs into a single output
    // approach: plug and chug
        Or(a=in[0], b=in[1], out=or1); // or gate returns 1 if either in[0] or in[1] is 1, else returns 0
        Or(a=or1, b=in[2], out=or2); // replaced every occurrence of 'out' with a unique variable name
        Or(a=or2, b=in[3], out=or3);
        Or(a=or3, b=in[4], out=or4);
        Or(a=or4, b=in[5], out=or5);
        Or(a=or5, b=in[6], out=or6);
        Or(a=or6, b=in[7], out=out);
}