// File name: projects/9/Square/Square.jack

// modified square jack file! 
// hello kitty bow catch
// move the basket with the left and right arrow keys.
// catch 5 bows to see hello kitty.
// press q to quit.

class SquareGame {

    // ---------- variables ----------
    // these keep track of the basket, bow, score, and next drop.
    field int basketX, bowX, bowY, score, dropIndex;

    // this array stores the different places the bows can fall from.
    field Array dropPositions;


    // ---------- setting up the game ----------
    // i set the basket near the middle and start the score at 0.
    constructor SquareGame new() {
        let basketX = 232;
        let score = 0;
        let dropIndex = 0;

        // i used 5 positions so the bow falls in different places.
        // after the last position, the game goes back to the first.
        let dropPositions = Array.new(5);
        let dropPositions[0] = 250;
        let dropPositions[1] = 110;
        let dropPositions[2] = 380;
        let dropPositions[3] = 165;
        let dropPositions[4] = 320;

        // this puts the first bow at its starting position.
        do resetBow();
        return this;
    }


    // ---------- cleaning up memory ----------
    // this frees the array and game object when the game ends.
    method void dispose() {
        do dropPositions.dispose();
        do Memory.deAlloc(this);
        return;
    }


    // ---------- starting the game ----------
    method void run() {
        var int key, previousBottom;

        // clear the screen before drawing anything.
        do Screen.clearScreen();

        // show the controls and score at the top.
        do Output.moveCursor(0, 0);
        do Output.printString(
            "BOW CATCH  |  Arrow keys: move  |  Q: quit"
        );
        do showScore();

        // true sets the drawing color to black.
        do Screen.setColor(true);
        do drawBasket();
        do drawBow(bowX, bowY);

        // check which key is being pressed.
        let key = Keyboard.keyPressed();


        // ---------- main game loop ----------
        // keep playing until the score reaches 5 or q is pressed.
        // ~ means not, and | means or.
        // 81 is uppercase Q and 113 is lowercase q.
        while ((score < 5) & (~((key = 81) | (key = 113)))) {

            // erase the old bow and basket before moving them.
            // false sets the drawing color to white.
            do Screen.setColor(false);
            do drawBow(bowX, bowY);
            do drawBasket();


            // ---------- moving the basket ----------
            // 130 is the left arrow key.
            // the position check keeps the basket on the screen.
            if ((key = 130) & (basketX > 0)) {
                let basketX = basketX - 8;
            }

            // 132 is the right arrow key.
            if ((key = 132) & (basketX < 464)) {
                let basketX = basketX + 8;
            }


            // ---------- moving the bow ----------
            // save the bottom of the bow before it moves.
            // the bow extends 7 pixels below its center.
            let previousBottom = bowY + 7;

            // adding to y moves the bow down the screen.
            let bowY = bowY + 4;


            // ---------- checking for a catch ----------
            // check when the bottom of the bow reaches the basket.
            // the top of the basket is at y = 218.
            if ((previousBottom < 218) & (~((bowY + 7) < 218))) {

                // check whether the bow overlaps the basket.
                // the bow extends 13 pixels to each side.
                if ((~((bowX + 13) < basketX)) &
                    (~((bowX - 13) > (basketX + 47)))) {

                    // add a point, update the score, and drop a new bow.
                    let score = score + 1;
                    do showScore();
                    do resetBow();
                }
            }


            // ---------- handling a missed bow ----------
            // if the bow falls past the basket, start another one.
            if (bowY > 242) {
                do resetBow();
            }


            // ---------- updating the screen ----------
            // redraw everything at its new position.
            do Screen.setColor(true);
            do drawBow(bowX, bowY);
            do drawBasket();

            // this short pause controls how fast the game moves.
            do Sys.wait(25);

            // check the keyboard again before the next loop.
            let key = Keyboard.keyPressed();
        }


        // ---------- ending the game ----------
        do Screen.clearScreen();
        do Output.moveCursor(3, 21);

        // catching 5 bows shows hello kitty with her bow.
        if (score = 5) {
            do Output.printString("You found my bow!");
            do drawHelloKitty();
        } else {
            // this shows if the player quits early.
            do Output.printString("Thanks for playing!");
        }

        return;
    }


    // ---------- resetting the bow ----------
    // move the bow back to the top at the next drop position.
    method void resetBow() {
        let bowX = dropPositions[dropIndex];
        let bowY = 32;

        let dropIndex = dropIndex + 1;

        // array positions go from 0 to 4, so restart after position 4.
        if (dropIndex = 5) {
            let dropIndex = 0;
        }

        return;
    }


    // ---------- displaying the score ----------
    // this updates the number of bows caught.
    method void showScore() {
        do Output.moveCursor(1, 0);
        do Output.printString("Bows caught: ");
        do Output.printInt(score);
        do Output.printString(" / 5");
        return;
    }


    // ---------- drawing the basket ----------
    // all the x coordinates use basketX so the whole basket moves together.
    // this also erases the basket when the drawing color is white.
    method void drawBasket() {

        // top rim of the basket.
        do Screen.drawRectangle(
            basketX, 218, basketX + 47, 220
        );

        // left side.
        do Screen.drawLine(
            basketX + 3, 221, basketX + 10, 234
        );

        // right side.
        do Screen.drawLine(
            basketX + 44, 221, basketX + 37, 234
        );

        // bottom of the basket.
        do Screen.drawLine(
            basketX + 10, 234, basketX + 37, 234
        );

        return;
    }


    // ---------- drawing the bow ----------
    // x and y are the center of the bow.
    // i used two triangle shapes and a circle for the middle.
    // this also erases the bow when the drawing color is white.
    method void drawBow(int x, int y) {

        // left side of the bow.
        do Screen.drawLine(x - 3, y, x - 13, y - 7);
        do Screen.drawLine(x - 13, y - 7, x - 13, y + 7);
        do Screen.drawLine(x - 13, y + 7, x - 3, y);

        // right side of the bow.
        do Screen.drawLine(x + 3, y, x + 13, y - 7);
        do Screen.drawLine(x + 13, y - 7, x + 13, y + 7);
        do Screen.drawLine(x + 13, y + 7, x + 3, y);

        // knot in the middle.
        do Screen.drawCircle(x, y, 3);

        return;
    }


    // ---------- drawing hello kitty ----------
    // this drawing appears after the player catches 5 bows.
    method void drawHelloKitty() {
        do Screen.setColor(true);

        // these lines make the outline of her head and ears.
        do Screen.drawLine(203, 118, 206, 87);
        do Screen.drawLine(206, 87, 230, 102);
        do Screen.drawLine(230, 102, 279, 102);
        do Screen.drawLine(279, 102, 302, 87);
        do Screen.drawLine(302, 87, 309, 118);
        do Screen.drawLine(309, 118, 315, 142);
        do Screen.drawLine(315, 142, 307, 159);
        do Screen.drawLine(307, 159, 289, 172);
        do Screen.drawLine(289, 172, 222, 172);
        do Screen.drawLine(222, 172, 204, 159);
        do Screen.drawLine(204, 159, 196, 142);
        do Screen.drawLine(196, 142, 203, 118);

        // eyes.
        do Screen.drawCircle(232, 136, 3);
        do Screen.drawCircle(280, 136, 3);

        // nose.
        do Screen.drawRectangle(253, 147, 259, 150);

        // whiskers on the left.
        do Screen.drawLine(210, 132, 181, 126);
        do Screen.drawLine(210, 140, 179, 140);
        do Screen.drawLine(210, 148, 183, 155);

        // whiskers on the right.
        do Screen.drawLine(302, 132, 331, 126);
        do Screen.drawLine(302, 140, 333, 140);
        do Screen.drawLine(302, 148, 329, 155);

        // erase the lines behind the bow so they do not overlap it.
        do Screen.setColor(false);
        do Screen.drawRectangle(284, 94, 310, 108);

        // reuse the bow method to add her bow near her ear.
        do Screen.setColor(true);
        do drawBow(297, 101);

        return;
    }
}